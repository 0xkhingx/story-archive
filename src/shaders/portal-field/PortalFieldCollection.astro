---
/**
 * PortalFieldCollection (portal-field variant) — Astro port of the exact
 * ThreeUI source bundle (revision SHA-256 f90e34f83d51).
 *
 * srcDoc assembly lives in ./build-srcdoc (plain .ts) so no HTML parser
 * ever scans the embedded document strings.
 */
import { buildPortalSrcDoc, PORTAL_BACKGROUND } from "./build-srcdoc";

export interface Props {
  speed?: number;
  size?: number;
  gap?: number;
  length?: number;
  density?: number;
  strokeWidth?: number;
  opacity?: number;
  hue?: number;
  saturation?: number;
  brightness?: number;
  className?: string;
}

const {
  speed = 1,
  size = 1,
  gap = 2,
  length = 1,
  density = 1,
  strokeWidth = 1,
  opacity = 1,
  hue = 0,
  saturation = 1,
  brightness = 1,
  className = "",
} = Astro.props;

const clamp = (v: number, min: number, max: number) => Math.min(max, Math.max(min, v));

const safeSpeed = clamp(speed, 0, 3);
const safeSize = clamp(size, 0.05, 200);
const safeGap = clamp(gap, 0, 64);
const safeLength = clamp(length, 0.35, 2.5);
const safeDensity = clamp(density, 0.25, 2.5);
const safeStrokeWidth = clamp(strokeWidth, 0.25, 8);
const safeOpacity = clamp(opacity, 0.05, 1);
const safeHue = clamp(hue, -180, 180);
const safeSaturation = clamp(saturation, 0, 2);
const safeBrightness = clamp(brightness, 0.35, 1.65);

const srcDoc = buildPortalSrcDoc({
  size: safeSize,
  gap: safeGap,
  length: safeLength,
  density: safeDensity,
  strokeWidth: safeStrokeWidth,
});

const filter =
  safeHue === 0 && safeSaturation === 1 && safeBrightness === 1
    ? undefined
    : `hue-rotate(${safeHue}deg) saturate(${safeSaturation}) brightness(${safeBrightness})`;

const liveControls = JSON.stringify({
  mode: "dark",
  speed: safeSpeed,
  size: safeSize,
  gap: safeGap,
  length: safeLength,
  density: safeDensity,
  strokeWidth: safeStrokeWidth,
  opacity: safeOpacity,
});
---
<iframe
  title="Portal Field"
  srcdoc={srcDoc}
  sandbox="allow-scripts"
  loading="eager"
  data-portal-field
  data-controls={liveControls}
  class:list={["portal-field-frame", className]}
  style={{
    display: "block",
    width: "100%",
    height: "100%",
    border: 0,
    background: PORTAL_BACKGROUND,
    opacity: String(safeOpacity),
    ...(filter ? { filter } : {}),
  }}
/>
<script>
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  document.querySelectorAll("iframe[data-portal-field]").forEach((frame) => {
    if (!(frame instanceof HTMLIFrameElement)) return;
    frame.addEventListener("load", () => {
      try {
        const controls = JSON.parse(frame.dataset.controls || "{}");
        if (reduced) controls.speed = 0;
        frame.contentWindow?.postMessage({ type: "threeui-controls", controls }, "*");
      } catch (_) {}
    });
  });
</script>

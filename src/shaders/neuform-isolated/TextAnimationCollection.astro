---
/**
 * TextAnimationCollection (threeui-intro variant) — Astro port of the exact
 * ThreeUI source bundle (revision 5a736cd3c1f6f19802f61ebb10e1701b9f7aa26e).
 *
 * srcDoc assembly lives in ./build-wordmark-srcdoc (plain .ts) so no HTML
 * parser ever scans the embedded document strings.
 *
 * One deliberate parameterization: the authored wordmark text ("ThreeUI") is
 * exposed as an optional `text` prop (default: exact authored value) so the
 * same assembly mechanism can set our own headers. Structure, shaders,
 * motion, timing, and isolation are untouched.
 */
import { buildWordmarkSrcDoc, wordmarkBackground, WORDMARK_TITLE } from "./build-wordmark-srcdoc";

export interface Props {
  variant?: "threeui-intro";
  mode?: "dark" | "light";
  hue?: number;
  saturation?: number;
  brightness?: number;
  className?: string;
  /** Wordmark text set into the authored assembly. Default: exact authored value. */
  text?: string;
}

const {
  mode = "dark",
  hue = 0,
  saturation = 1,
  brightness = 1,
  className = "",
  text = "ThreeUI",
} = Astro.props;

const clamp = (v: number, min: number, max: number) => Math.min(max, Math.max(min, v));
const safeMode = mode === "light" ? "light" : "dark";
const safeHue = clamp(hue, -180, 180);
const safeSaturation = clamp(saturation, 0, 2);
const safeBrightness = clamp(brightness, 0.35, 1.65);
const background = wordmarkBackground(safeMode);

const srcDoc = buildWordmarkSrcDoc({ mode: safeMode, text });

const filter =
  safeHue === 0 && safeSaturation === 1 && safeBrightness === 1
    ? undefined
    : `hue-rotate(${safeHue}deg) saturate(${safeSaturation}) brightness(${safeBrightness})`;
---
<iframe
  title={WORDMARK_TITLE}
  srcdoc={srcDoc}
  sandbox="allow-scripts"
  loading="lazy"
  data-mode={safeMode}
  class:list={["threeui-wordmark-frame", className]}
  style={{
    display: "block",
    width: "100%",
    height: "100%",
    border: 0,
    background,
    ...(filter ? { filter } : {}),
  }}
/>

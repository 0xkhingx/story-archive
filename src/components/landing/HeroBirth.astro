<section class="birth" data-birth aria-label="The archive world being born out of the dark">
  <div class="birth-sticky">
    <div class="birth-paper" data-birth-paper aria-hidden="true"></div>
    <div class="birth-torn" data-birth-torn aria-hidden="true"></div>
    <figure class="birth-fig" data-birth-fig>
      <img
        src="/images/environments/street-walk.webp"
        alt="Young man with headphones walking through a Lagos street at sunset, danfo buses and power lines behind him"
        loading="eager"
        decoding="async"
      />
    </figure>
    <div class="birth-copy" data-birth-copy>
      <p class="label">The archive</p>
      <h1 class="birth-title" data-birth-title>Things that stayed.</h1>
      <p class="birth-sub">“Some made me think. Some stayed longer than I expected.”</p>
    </div>
  </div>
</section>

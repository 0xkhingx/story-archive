---
import ScrollHint from "../shared/ScrollHint.astro";
---
<section class="black-void" aria-label="Entrance">
  <div class="scene-black" data-scene="1">
    <div class="fade-late">
      <p class="latin-line">viri nascuntur ideo<br />memento quod mori debebis</p>
      <div class="rule" style="margin-inline:auto"></div>
    </div>
    <ScrollHint />
  </div>
  <div class="scene-black" data-scene="2">
    <div class="reveal">
      <p class="latin-line">Nolito mori sine narrando<br />fabulas tuas</p>
      <div><span class="tiny-mark" aria-hidden="true"></span></div>
    </div>
  </div>
</section>

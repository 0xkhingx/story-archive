---
---
<section class="cine" data-cat-stage aria-label="The three shelves of the archive">
  <div class="cine-sticky">
    <article class="cine-panel is-first" data-cat-panel>
      <figure class="cine-fig">
        <img src="/images/environments/films-collage.webp" alt="Retro cinematic collage of film characters in torn-paper strips" loading="lazy" decoding="async" data-cat-img />
      </figure>
      <div class="cine-text pos-left">
        <p class="cine-kicker">stories seen on screen</p>
        <h2 class="cine-type">{"FILMS".split("").map((ch) => <span class="cine-char">{ch}</span>)}</h2>
        <p class="cine-line">Stories borrowed from the screen, but carried out into life.</p>
      </div>
    </article>
    <article class="cine-panel word-long" data-cat-panel>
      <figure class="cine-fig">
        <img src="/images/environments/animation-collage.webp" alt="Retro collage of beloved animation and cartoon characters" loading="lazy" decoding="async" data-cat-img />
      </figure>
      <div class="cine-text pos-right">
        <p class="cine-kicker">stories drawn into life</p>
        <h2 class="cine-type">{"ANIMATION".split("").map((ch) => <span class="cine-char">{ch}</span>)}</h2>
        <p class="cine-line">Sometimes drawings say things real people never manage to.</p>
      </div>
    </article>
    <article class="cine-panel" data-cat-panel>
      <figure class="cine-fig">
        <img src="/images/observer/writing-desk.webp" alt="The observer writing in a notebook at his desk, headphones on, evening light through the window" loading="lazy" decoding="async" data-cat-img />
      </figure>
      <div class="cine-text pos-ground">
        <p class="cine-kicker">stories actually lived</p>
        <h2 class="cine-type">{"LIFE".split("").map((ch) => <span class="cine-char">{ch}</span>)}</h2>
        <p class="cine-line">The ones that actually happened to me. Some funny. Some less so.</p>
      </div>
    </article>
  </div>
</section>

---
interface Props {
  tiny?: string;
  next: { slug: string; title: string; cover: string; num: string; category: string };
}
const { tiny = "Kept here so I don't lose it.", next } = Astro.props;
---
<section class="story-end" data-beat="ending">
  <p class="stayed" data-ending-stayed>That’s what stayed.</p>
  <p class="tiny" data-ending-stayed>{tiny}</p>
  <a class="next-story" data-ending-next href={`/stories/${next.slug}`}>
    <img src={next.cover} alt="" loading="lazy" decoding="async" />
    <span>
      <span class="go">Next story →</span>
      <span class="t" style="display:block">{next.category} / {next.num} — {next.title}</span>
    </span>
  </a>
</section>

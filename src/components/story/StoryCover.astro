---
interface Props {
  category: string;
  num: string;
  title: string;
  thought: string;
  meta: string;
  cover: string;
  coverAlt?: string;
}
const { category, num, title, thought, meta, cover, coverAlt = "" } = Astro.props;
---
<section class="story-cover" data-beat="cover">
  <p class="eyebrow" data-cover-line>{category} / {num}</p>
  <p class="meta" data-cover-line>{meta}</p>
  <h1 data-cover-line>{title}</h1>
  <p class="thought" data-cover-line>{thought}</p>
  <figure data-cover-figure>
    <img src={cover} alt={coverAlt} loading="eager" decoding="async" data-cover-img />
  </figure>
</section>

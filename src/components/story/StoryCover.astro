---
interface Props {
  category: string;
  num: string;
  title: string;
  thought: string;
  meta: string;
  cover: string;
  coverAlt?: string;
}
const { category, num, title, thought, meta, cover, coverAlt = "" } = Astro.props;

const DIMS: Record<string, [number, number]> = {
  "/images/environments/animation-collage.webp": [1600, 800],
  "/images/environments/films-collage.webp": [1600, 793],
  "/images/environments/street-walk.webp": [1122, 1402],
  "/images/observer/bus-window.webp": [1122, 1402],
  "/images/stories/blue-spirit/cover-zuko.webp": [1448, 1086],
};
const [w, h] = DIMS[cover] ?? [];
---
<section class="story-cover" data-beat="cover">
  <p class="eyebrow" data-cover-line>{category} / {num}</p>
  <p class="meta" data-cover-line>{meta}</p>
  <h1 data-cover-line>{title}</h1>
  <p class="thought" data-cover-line>{thought}</p>
  <figure data-cover-figure>
    <img src={cover} alt={coverAlt} width={w} height={h} loading="eager" decoding="async" data-cover-img />
  </figure>
</section>
